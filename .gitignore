# Obsidian Copilot plugin state — tool output, not knowledge
copilot/

# Obsidian local UI state
.obsidian/workspace*
.obsidian/plugins/*/data.json
.trash/

# OS
.DS_Store

# raw/ binaries: 146MB+ of PDFs, already backed up by OneDrive.
# git-lfs is not installed; tracking these would bloat the repo permanently.
# Paths stay lint-checked on disk — only the bytes are untracked.
raw/**/*.pdf
raw/**/*.epub
raw/assets/

# Ingest pipeline staging (session backups, claims, plans)
meta/.ingest/

# Researcher profile staging (manifests, verify snapshots)
meta/.researcher/

# Distill pipeline staging (session backups, plans)
meta/.distill/

# Semantic find bundles (transient LLM review packets)
meta/.semfind/

# Pixi environment
.pixi/

# LLM share bundles (meta/export.py)
.exported/

# Obsidian artifacts — use raw/inbox/ for clips; canvases/bases belong in wiki/ or delete
Clippings/
*.canvas
*.base

.obsidian/graph.json

# Python bytecode
__pycache__/

# Staged for deletion — not part of the vault
_quarantine/

# Claude Code local state
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
