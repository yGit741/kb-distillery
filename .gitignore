# Obsidian Copilot plugin state — tool output, not knowledge
copilot/

# Obsidian: only app.json, core-plugins.json and community-plugins.json are tracked (what another
# vault user needs to open it). Everything else — workspace, appearance, graph, plugin bundles
# (25MB of minified JS, reinstallable from community-plugins.json) — is local state.
.obsidian/*
!.obsidian/app.json
!.obsidian/core-plugins.json
!.obsidian/community-plugins.json
.trash/

# OS
.DS_Store

# raw/ binaries: 146MB+ of PDFs, already backed up by OneDrive.
# git-lfs is not installed; tracking these would bloat the repo permanently.
# Paths stay lint-checked on disk — only the bytes are untracked.
raw/**/*.pdf
raw/**/*.epub
raw/assets/

# Ingest pipeline staging (session backups, claims, plans)
meta/.ingest/

# Researcher profile staging (manifests, verify snapshots)
meta/.researcher/
meta/.migrate/

# Distill pipeline staging (session backups, plans)
meta/.distill/

# Semantic find bundles (transient LLM review packets)
meta/.semfind/

# Knowledge ops runtime (lock, open edit session, pending commit label)
meta/.ops/

# Pixi environment
.pixi/

# LLM share bundles (meta/export.py)
.exported/

# Share build cache + deploy status (meta/share)
.cache/

# Obsidian artifacts — use raw/inbox/ for clips; canvases/bases belong in wiki/ or delete
Clippings/
*.canvas
*.base

# Python bytecode
__pycache__/

# Staged for deletion — not part of the vault
_quarantine/

# Claude Code local state
.claude/worktrees/
# Browser-automation output (Playwright MCP screenshots/traces)
.playwright-mcp/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Mail/chat screenshots (~36MB): binary noise for Gemini GitHub import
raw/**/*.png
meta/chats/**/*.png

# Other raw/ binaries — OneDrive backs them up; keep git text-only
raw/**/*.pptx
raw/**/*.ppt
raw/**/*.docx
raw/**/*.jpg
raw/**/*.jpeg
raw/**/*.gif
raw/**/*.webp
raw/**/*.heic
raw/**/*.zip

# Obsidian Copilot agent-skill mirrors + cache (regenerated by the plugin)
.agents/
.copilot/
.opencode/

# Generated dumps / scratch
repomix-output.xml
*.canvas-llm
Untitled*.md
