# Obsidian Copilot plugin state — tool output, not knowledge
copilot/

# Backlog items: local state, one file per idea or unstarted plan (kb_distillery.services.backlog)
.backlog/

# Obsidian: only app.json, core-plugins.json and community-plugins.json are tracked (what another
# vault user needs to open it). Everything else — workspace, appearance, graph, plugin bundles
# (25MB of minified JS, reinstallable from community-plugins.json) — is local state.
.obsidian/*
!.obsidian/app.json
!.obsidian/core-plugins.json
!.obsidian/community-plugins.json
.trash/

# OS
.DS_Store

# raw/ binaries (PDFs, e-books): too large for plain git history.
# git-lfs is not assumed; tracking these would bloat the repo permanently.
# Paths stay lint-checked on disk — only the bytes are untracked.
raw/**/*.pdf
raw/**/*.epub
raw/assets/

# Researcher profile staging (manifests, verify snapshots)
meta/.researcher/

# Distill pipeline staging (session backups, plans)
meta/.distill/

# Semantic find bundles (transient LLM review packets)
meta/.semfind/

# Knowledge ops runtime (lock, open edit session, pending commit label)
meta/.ops/

# Pixi environment
.pixi

# LLM share bundles (src/kb_distillery/publish/export.py)
.exported/

# Share build cache + deploy status (src/kb_distillery/publish/cloudflare); wrangler's local state
.cache/
.wrangler/

# Obsidian artifacts — use raw/inbox/ for clips; canvases/bases belong in wiki/ or delete
Clippings/
*.canvas
*.base

# Python bytecode
__pycache__/

# Staged for deletion — not part of the vault
_quarantine/

# Claude Code local state
.claude/worktrees/
# Browser-automation output (Playwright MCP screenshots/traces)
.playwright-mcp/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Mail/chat screenshots: binary noise
raw/**/*.png
meta/chats/**/*.png

# Other raw/ binaries; keep git text-only
raw/**/*.pptx
raw/**/*.ppt
raw/**/*.docx
raw/**/*.jpg
raw/**/*.jpeg
raw/**/*.gif
raw/**/*.webp
raw/**/*.heic
raw/**/*.zip

# Obsidian Copilot agent-skill mirrors + cache (regenerated by the plugin)
.agents/
.copilot/
.opencode/

# Generated dumps / scratch
repomix-output.xml
*.canvas-llm
Untitled*.md

# Frontend build output is never committed: kb_distillery.server rebuilds src/kb_distillery/_webapp from source on start when the
# sources changed, share builds dist-share/ on demand (web-check fails if either is tracked)
web/node_modules
scripts/qmd/node_modules
src/kb_distillery/_webapp/
web/dist-share/
# `pixi run build-wheel` output
/dist/

# Other agents' skill folders (not ours; skills are kits/*/skills for a kb, .claude/skills for the engine)
.agents/
.opencode/
.copilot/

# Knowledge bases live in ~/knowledge/<id> (kb_distillery.config.kb), outside this checkout. kbs/* stays ignored as a guard
# so a stray kb folder here can never be committed to the engine repo; the public demo lives in examples/demo.
kbs/*

# The Worker inbox bundles the web checker at deploy/test time (build-okf.mjs); never committed
src/kb_distillery/publish/cloudflare/worker/okf.gen.js
