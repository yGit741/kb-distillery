# Obsidian Copilot plugin state — tool output, not knowledge
copilot/

# Obsidian local UI state
.obsidian/workspace*

# Obsidian plugin code: 25MB of minified JS, reinstallable from community-plugins.json.
# Kept out of git so Gemini's GitHub import reads the notes, not plugin bundles.
.obsidian/plugins/
.trash/

# OS
.DS_Store

# raw/ binaries: 146MB+ of PDFs, already backed up by OneDrive.
# git-lfs is not installed; tracking these would bloat the repo permanently.
# Paths stay lint-checked on disk — only the bytes are untracked.
raw/**/*.pdf
raw/**/*.epub
raw/assets/

# Ingest pipeline staging (session backups, claims, plans)
meta/.ingest/

# Researcher profile staging (manifests, verify snapshots)
meta/.researcher/

# Distill pipeline staging (session backups, plans)
meta/.distill/

# Semantic find bundles (transient LLM review packets)
meta/.semfind/

# Knowledge ops runtime (lock, open edit session, pending commit label)
meta/.ops/

# Pixi environment
.pixi/

# LLM share bundles (meta/export.py)
.exported/

# Obsidian artifacts — use raw/inbox/ for clips; canvases/bases belong in wiki/ or delete
Clippings/
*.canvas
*.base

.obsidian/graph.json

# Python bytecode
__pycache__/

# Staged for deletion — not part of the vault
_quarantine/

# Claude Code local state
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Mail/chat screenshots (~36MB): binary noise for Gemini GitHub import
raw/**/*.png
meta/chats/**/*.png

# Other raw/ binaries — OneDrive backs them up; keep git text-only
raw/**/*.pptx
raw/**/*.ppt
raw/**/*.docx
raw/**/*.jpg
raw/**/*.jpeg
raw/**/*.gif
raw/**/*.heic
raw/**/*.zip

# Obsidian Copilot agent-skill mirrors + cache (regenerated by the plugin)
.agents/
.copilot/
.opencode/

# Generated dumps / scratch
repomix-output.xml
*.canvas-llm
Untitled*.md
