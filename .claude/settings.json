{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"$CLAUDE_PROJECT_DIR/backend/src\" python3 -m kb.git.guard"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.cursor/hooks/block-git-write.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"$CLAUDE_PROJECT_DIR/backend/src\" python3 -m kb.git.merge_nudge",
            "timeout": 20,
            "statusMessage": "Checking for a PR awaiting merge…"
          },
          {
            "type": "command",
            "command": "PYTHONPATH=\"$CLAUDE_PROJECT_DIR/backend/src\" python3 -m kb.git.proof_nudge",
            "timeout": 10,
            "statusMessage": "Checking the reply shows proof…"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pixi run ship -- merge)",
      "Bash(pixi run ship -- merge:*)"
    ]
  }
}
