{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks-python.sh\" kb.git.guard"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/block-git-write.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks-python.sh\" kb.git.merge_nudge",
            "timeout": 20,
            "statusMessage": "Checking for a PR awaiting merge…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks-python.sh\" kb.git.proof_nudge",
            "timeout": 10,
            "statusMessage": "Checking the reply shows proof…"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pixi run ship -- merge)",
      "Bash(pixi run ship -- merge:*)"
    ],
    "deny": [
      "Bash(pixi run share -- deploy*)",
      "Bash(pixi run share deploy*)",
      "Bash(pixi run share -- rollback*)",
      "Bash(pixi run share rollback*)",
      "Bash(*KB_SHARE_DIRECT*)",
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler versions deploy*)",
      "Bash(*wrangler versions upload*)",
      "Bash(*wrangler rollback*)",
      "Bash(*kb.share.owner run*)",
      "Bash(*kb.share.owner once*)"
    ]
  }
}
