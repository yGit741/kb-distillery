#!/bin/bash
# main only moves forward, by kb(...) steps (z+1); snapshot tags kb-x.y.z are annotated and match KB-Version.
# Fails closed: a missing `distill` blocks the git operation. KB_ROOT is this repo, so the hook never works on another kb.
command -v distill >/dev/null 2>&1 || {
  echo "kb hook pre-push: 'distill' is not on PATH - refusing (fail closed). Install kb-distillery (pip install kb-distillery) or put its bin folder on PATH." >&2
  exit 2
}
KB_ROOT="$(git rev-parse --show-toplevel)" || exit 2
export KB_ROOT
exec distill hook pre-push "$@"
