#!/bin/bash
# KB Conventional Commits in a knowledge base repo: kb(op): ... (kb-x.y.z) on main.
# Fails closed: a missing `distill` blocks the git operation. KB_ROOT is this repo, so the hook never works on another kb.
command -v distill >/dev/null 2>&1 || {
  echo "kb hook commit-msg: 'distill' is not on PATH - refusing (fail closed). Install kb-distillery (pip install kb-distillery) or put its bin folder on PATH." >&2
  exit 2
}
KB_ROOT="$(git rev-parse --show-toplevel)" || exit 2
export KB_ROOT
exec distill hook commit-msg "$@"
