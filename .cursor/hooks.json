{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Write|StrReplace|EditNotebook|Delete",
        "command": "python3 meta/guard.py",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/block-git-write.sh",
        "matcher": "git|gh |pixi run|meta/daily_sync|meta/ship|meta/curate_history|meta\\.ops",
        "failClosed": true
      }
    ]
  }
}
