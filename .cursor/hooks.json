{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Write|StrReplace|EditNotebook|Delete",
        "command": "PYTHONPATH=backend/src python3 -m kb.git.guard",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/block-git-write.sh",
        "matcher": "git|gh |pixi run|kb\\.maintenance\\.daily_sync|kb\\.git\\.ship|kb\\.git\\.curate_history|kb\\.ops",
        "failClosed": true
      }
    ]
  }
}
