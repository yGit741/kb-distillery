<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install-deploy-owner.sh fills in __ROOT__, __PIXI__ and __LOG__.
     The single deploy owner of the private site (kb.share.owner run); always on, restarted on exit. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.thesis-kb.deploy-owner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "__ROOT__" &amp;&amp; echo "=== $(date) deploy owner start" &amp;&amp; exec "__PIXI__" run python -m kb.share.owner run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
