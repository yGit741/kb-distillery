#!/bin/bash
# Knowledge-base repo pre-commit: the engine's linter is the schema; a commit that fails it breaks the vault.
# `pixi run ops` (in the engine) lints once per operation and hands over a one-time token, so its commits
# skip the second run. Installed into a knowledge base by `kbd install-kb-hooks --kb <id|path>`.
. "$(dirname "$0")/env.sh"
token_file="$(git rev-parse --git-path kb-linted)"
if [ -n "$KB_LINTED" ] && [ -f "$token_file" ] && [ "$(cat "$token_file")" = "$KB_LINTED" ]; then
  exit 0
fi
cd "$engine" && "$py" -m kb.lint.lint || { echo "pre-commit: lint failed — nothing committed" >&2; exit 1; }
