# `git archive` builds the public repo from this tree; these paths are the owner's private workflow and stay out of it.
CLAUDE.md export-ignore
.claude export-ignore
.claude/** export-ignore
.integrator.toml export-ignore
# Maintainer-only history: kept in the repository, left out of `git archive` (the public export).
docs/archive/** export-ignore
# Owner-only: deploys the owner's private site; one-time owner launchd migration.
.github/workflows/deploy-main.yml export-ignore
examples/launchd/switch.sh export-ignore
